# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다.

# 생성 (config/model_config.py 의 openai 모델들)
OPENAI_API_KEY=        

# 나라장터 입찰공고정보서비스 (data.go.kr) — 디코딩 키
DATA_API_KEY=         

# 시나리오 B — 외부 API (안 쓰면 비워 둔다)
COHERE_API_KEY=

# 임베딩 접두어. 모델마다 다르고, 안 붙이면 오류 없이 성능만 깎인다.
#   arctic-embed-ko    질의 "query: "                       문서 없음
#   embeddinggemma     질의 "task: search result | query: "  문서 "title: none | text: "
#   BGE-m3             둘 다 없음
# 질의 쪽만 바꾸면 재인덱싱이 필요 없다. 문서 쪽을 바꾸면 다시 만들어야 한다.
EMBED_QUERY_PREFIX=
EMBED_DOC_PREFIX=

# 생성 서버 (SGLang). 모델은 여기서 안 정한다 — UI 가 고르면 컨테이너를 갈아끼운다.
SGLANG_URL=http://localhost:8087
# 처음 받는 8B 는 내려받기만 몇 분이다. 교체를 몇 초까지 기다릴지.
SGLANG_SWAP_TIMEOUT=900

# 벡터 저장소. faiss | lance. LanceDB 는 나란히 두고 재 보는 중이다.
STORE=faiss
